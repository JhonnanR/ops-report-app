# Copy to .env.local for local dev. On Vercel, add these under Project Settings > Environment Variables.

# Notion internal integration token (Settings > Connections > Develop integrations).
# Share each of the 4 databases below with this integration.
NOTION_TOKEN=secret_xxx

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Notion database IDs (already filled in from your workspace)
NOTION_SUPERVISORS_DB=c9cc3260256d4cb5b6dfeca804f181f3
NOTION_PROJECTS_DB=8cff1ccf3b6e4e06a205034b718f8bfb
NOTION_BUILDINGS_DB=be432f4afbdc4e0b90db63918852da68
NOTION_ELEVATIONS_DB=3d675b2d077e8068a995c00e758af0d1

# Set to "true" to show elevations named "Test ..." in the dropdown
SHOW_TEST_ELEVATIONS=false

# Hours a supervisor stays signed in
SESSION_HOURS=12
